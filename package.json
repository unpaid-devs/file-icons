{
  "name": "@unpaid-devs/file-icons",
  "version": "0.1.0",
  "description": "File type icons for React, covering documents, CAD, BIM, GIS, media and archives",
  "license": "MIT",
  "author": "Unpaid Devs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unpaid-devs/file-icons.git"
  },
  "bugs": {
    "url": "https://github.com/unpaid-devs/file-icons/issues"
  },
  "homepage": "https://github.com/unpaid-devs/file-icons#readme",
  "keywords": [
    "react",
    "file",
    "icons",
    "svg",
    "file-type",
    "extension",
    "cad",
    "bim"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.24.0"
}